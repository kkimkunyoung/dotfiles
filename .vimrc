" Encoding
set encoding=utf-8

" File type detection
filetype on

" Turn syntax highlighting on
if has("syntax")
    syntax on
endif

" Show line numbers
set number

" Show cursor line
set cursorline

" Show file stats
set ruler

" Whitespace
set autoindent
set smartindent
filetype indent on
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

" Searching
set hlsearch
set incsearch
set ignorecase
set smartcase

" Matching
set showmatch

" Status bar
set laststatus=2

" Clipboard
set clipboard=unnamed

" Mouse
set mouse=a
